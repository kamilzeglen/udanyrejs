PORT=5010
INTERNAL_TOKEN=change-me-to-a-long-random-secret
ALLOWED_SCRAPE_HOSTS=rejsy4you.pl
MAX_TERMS_PER_SCRAP=100
MIN_DELAY_MS=2000
MAX_DELAY_MS=5000
MAX_DISCOVERY_PAGES_PER_HOST=20
LISTING_RENDER_TIMEOUT_MS=8000

# Optional: set to "chrome" to use a locally installed Chrome instead of
# downloading Playwright's own bundled Chromium (useful for local dev
# machines without network access to the Playwright CDN). Leave unset in
# the Docker image, which already ships the bundled Chromium.
PLAYWRIGHT_CHANNEL=
